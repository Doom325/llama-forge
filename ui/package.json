{
	"name": "ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run check && npm run lint && npm run test:unit",
		"test:e2e": "playwright install && playwright test",
		"check:bundle": "node scripts/check-bundle-size.js",
		"audit:fetch": "node scripts/audit.js"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@types/dompurify": "^3.0.5",
		"@types/marked": "^5.0.2",
		"@types/node": "^24",
		"@vitest/coverage-v8": "^4.1.8",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"jsdom": "^29.1.1",
		"playwright": "^1.60.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vite-plugin-compression": "^0.5.1",
		"vitest": "^4.1.3"
	},
	"dependencies": {
		"@tanstack/svelte-query": "^6.1.33",
		"@tanstack/svelte-virtual": "^3.13.27",
		"@tanstack/table-core": "^8.21.3",
		"bits-ui": "^2.18.1",
		"dompurify": "^3.4.7",
		"echarts": "^6.1.0",
		"highlight.js": "^11.11.1",
		"marked": "^18.0.4"
	}
}
